# ── Sitio ──────────────────────────────────────────────
# URL pública final (sin barra al final). Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://hugograas.com.ar

# ── Supabase (Project Settings → API) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Solo para el script de creación de administradores (npm run create-admin). Nunca lo expongas en el front.
SUPABASE_SERVICE_ROLE_KEY=

# Dominio que se agrega al "usuario" del login.
# Ej: si el usuario escribe "graas", se inicia sesión con graas@hugograas.com.ar
ADMIN_USER_DOMAIN=hugograas.com.ar

# ── Cloudinary (Dashboard → API Keys) ─────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raíz donde se guardan las imágenes de la web
CLOUDINARY_FOLDER=graas
