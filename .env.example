# ── Sitio ──────────────────────────────────────────────
# URL pública final (sin barra al final). Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://hugograas.com.ar

# ── Supabase (Project Settings → API) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave "Publishable" (sb_publishable_...) o la "anon" anterior (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Clave "Secret" (sb_secret_...) o la "service_role" anterior. Solo para el script de creación de administradores (npm run create-admin). Nunca lo expongas en el front.
SUPABASE_SERVICE_ROLE_KEY=

# Dominio que se agrega al "usuario" del login.
# Ej: si el usuario escribe "graas", se inicia sesión con graas@hugograas.com.ar
ADMIN_USER_DOMAIN=hugograas.com.ar

# ── Cloudinary (Dashboard → API Keys) ─────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raíz donde se guardan las imágenes de la web
CLOUDINARY_FOLDER=graas

# ── Google (opcional, se pueden cargar después) ───────
# Search Console → Agregar propiedad → Etiqueta HTML → copiar solo el valor de "content"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 → ID de medición (G-XXXXXXXXXX). Mide visitas y clics a WhatsApp/teléfono/email.
NEXT_PUBLIC_GA_ID=

# ── Emails de aviso (Resend, gratis hasta 3.000 por mes) ──
# resend.com → API Keys → Create. El destinatario se configura en el panel → Ajustes del sitio.
RESEND_API_KEY=
# Remitente. Con el dominio verificado en Resend: "Web Graas <web@hugograas.com.ar>".
# Sin dominio verificado, dejalo vacío: Resend solo permite enviar al email con el que creaste la cuenta.
RESEND_FROM=
